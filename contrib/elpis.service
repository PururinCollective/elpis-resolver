# systemd unit for Elpis.
#
# Sockets are bound before privileges are dropped, so binding port 53 works
# with CAP_NET_BIND_SERVICE alone -- no need to run as root.
#
# It still needs an account to drop to, and systemd will not invent one.  A
# system user with no home and no shell is the whole of it -- elpis never logs
# in and owns nothing on disk:
#
#   useradd --system --user-group --no-create-home \
#           --shell /usr/sbin/nologin elpis
#
# (/sbin/nologin on RHEL and its relatives.)  Nothing needs chowning to it:
# the binary and its config stay root-owned and world-readable, the way
# make install leaves them, and elpis only ever reads them.
#
# ProtectSystem=strict and ReadOnlyPaths below make the install read-only for
# this service, whatever the files are owned by.  That is deliberate, and it
# means the status page cannot hash a plaintext `webgui-password` back into the
# config on first start -- it says so and carries on.  Hash it yourself instead
# of opening the sandbox back up:
#
#   /opt/elpis-resolver/bin/elpis --hash-password
#
# and paste the line it prints into the config.
#
# If you do turn on `pidfile` or `log-file`, put them somewhere systemd
# creates and hands to the service -- RuntimeDirectory=elpis for /run/elpis,
# LogsDirectory=elpis for /var/log/elpis -- because ProtectSystem=strict
# below leaves nothing else writable.  The defaults need neither: no pidfile,
# and stderr goes to the journal.
#
#   install -m0644 contrib/elpis.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now elpis

[Unit]
Description=ELPIS recursive DNS resolver
Documentation=https://github.com/PururinCollective/elpis-resolver
After=network-online.target
Wants=network-online.target

# Running under this unit, elpis is not root and cannot stop anything itself.
# Let systemd do it: starting elpis stops systemd-resolved, and the two can
# never be active at once fighting over port 53.  Drop these two lines if you
# keep resolved and run elpis on another port.
#
# Remember that stopping resolved leaves /etc/resolv.conf pointing at a stub
# that is no longer listening -- repoint it at elpis, or at 127.0.0.1.
Conflicts=systemd-resolved.service
After=systemd-resolved.service

[Service]
Type=simple
ExecStart=/opt/elpis-resolver/bin/elpis -d
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

User=elpis
Group=elpis
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The resolver reads its config at startup and writes nothing afterwards.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/opt/elpis-resolver/bin
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The cache sizes itself from what the host has.  Capping the cgroup here is
# also how you cap the cache: Elpis reads memory.max, not just MemTotal.
# MemoryMax=2G

[Install]
WantedBy=multi-user.target
