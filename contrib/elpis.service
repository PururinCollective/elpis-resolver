# systemd unit for Elpis.
#
# Sockets are bound before privileges are dropped, so binding port 53 works
# with CAP_NET_BIND_SERVICE alone -- no need to run as root.
#
#   install -m0644 contrib/elpis.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now elpis

[Unit]
Description=ΕΛΠΙΣ recursive DNS resolver
Documentation=https://github.com/PururinCollective/elpis-resolver
After=network-online.target
Wants=network-online.target

# Running under this unit, elpis is not root and cannot stop anything itself.
# Let systemd do it: starting elpis stops systemd-resolved, and the two can
# never be active at once fighting over port 53.  Drop these two lines if you
# keep resolved and run elpis on another port.
#
# Remember that stopping resolved leaves /etc/resolv.conf pointing at a stub
# that is no longer listening -- repoint it at elpis, or at 127.0.0.1.
Conflicts=systemd-resolved.service
After=systemd-resolved.service

[Service]
Type=simple
ExecStart=/opt/elpis/elpis -d
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

User=elpis
Group=elpis
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The resolver reads its config at startup and writes nothing afterwards.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/opt/elpis
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The cache sizes itself from what the host has.  Capping the cgroup here is
# also how you cap the cache: Elpis reads memory.max, not just MemTotal.
# MemoryMax=2G

[Install]
WantedBy=multi-user.target
